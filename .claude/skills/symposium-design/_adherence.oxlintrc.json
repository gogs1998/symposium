{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/chat/**",
              "components/core/**",
              "components/figures/**",
              "ui_kits/symposium-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Libre Caslon Display|Libre Caslon Text|Newsreader|Archivo|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Libre Caslon Display, Libre Caslon Text, Newsreader, Archivo, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|dot|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, dot, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|live|pending|danger)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'live' | 'pending' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconTrailing|disabled|full|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, iconTrailing, disabled, full, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|quiet)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<CategoryTab> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='CitationCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|excerpt|source|detail|index|videoTitle|timestamp|thumbnail|channelColor|href|onOpen|style|key|ref|className|style|children)$/]",
        "message": "<CitationCard> doesn't accept that prop. Declared props: variant, excerpt, source, detail, index, videoTitle, timestamp, thumbnail, channelColor, href, onOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CitationCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:book|video)$/]",
        "message": "<CitationCard> variant must be one of 'book' | 'video'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Composer'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|onSend|placeholder|figureName|busy|disclosure|style|key|ref|className|style|children)$/]",
        "message": "<Composer> doesn't accept that prop. Declared props: value, onChange, onSend, placeholder, figureName, busy, disclosure, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisclosureBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:figureName|inline|style|key|ref|className|style|children)$/]",
        "message": "<DisclosureBanner> doesn't accept that prop. Declared props: figureName, inline, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FigureCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|description|category|meta|accentColor|src|status|onClick|style|key|ref|className|style|children)$/]",
        "message": "<FigureCard> doesn't accept that prop. Declared props: name, description, category, meta, accentColor, src, status, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FigureCard'] > JSXAttribute[name.name='category'] > Literal[value!=/^(?:historical|creator)$/]",
        "message": "<FigureCard> category must be one of 'historical' | 'creator'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FigureCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:published|coming-soon)$/]",
        "message": "<FigureCard> status must be one of 'published' | 'coming-soon'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FigurePortrait'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|accentColor|category|shape|size|grain|style|key|ref|className|style|children)$/]",
        "message": "<FigurePortrait> doesn't accept that prop. Declared props: src, name, accentColor, category, shape, size, grain, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FigurePortrait'] > JSXAttribute[name.name='category'] > Literal[value!=/^(?:historical|creator)$/]",
        "message": "<FigurePortrait> category must be one of 'historical' | 'creator'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FigurePortrait'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:portrait|square|round)$/]",
        "message": "<FigurePortrait> shape must be one of 'portrait' | 'square' | 'round'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|variant|size|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: children, label, variant, size, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline|ghost)$/]",
        "message": "<IconButton> variant must be one of 'solid' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MessageBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:role|author|accentColor|children|citations|streaming|defaultOpen|style|key|ref|className|style|children)$/]",
        "message": "<MessageBubble> doesn't accept that prop. Declared props: role, author, accentColor, children, citations, streaming, defaultOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MessageBubble'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:user|assistant)$/]",
        "message": "<MessageBubble> role must be one of 'user' | 'assistant'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|figure|time|accentColor|key|ref|className|style|children)$/]",
        "message": "<SessionItem> doesn't accept that prop. Declared props: id, title, figure, time, accentColor."
      },
      {
        "selector": "JSXOpeningElement[name.name='SuggestedQuestion'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|accentColor|onClick|style|key|ref|className|style|children)$/]",
        "message": "<SuggestedQuestion> doesn't accept that prop. Declared props: children, accentColor, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|kind|accentColor|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, kind, accentColor, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:category|era|channel)$/]",
        "message": "<Tag> kind must be one of 'category' | 'era' | 'channel'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TypingIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:author|accentColor|label|style|key|ref|className|style|children)$/]",
        "message": "<TypingIndicator> doesn't accept that prop. Declared props: author, accentColor, label, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
