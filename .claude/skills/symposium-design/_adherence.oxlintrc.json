{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/chat/**",
              "components/roster/**",
              "components/trust/**",
              "ui_kits/app/**",
              "ui_kits/landing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Marcellus|Spectral|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Marcellus, Spectral, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryTabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|active|onChange|counts|key|ref|className|style|children)$/]",
        "message": "<CategoryTabs> doesn't accept that prop. Declared props: tabs, active, onChange, counts."
      },
      {
        "selector": "JSXOpeningElement[name.name='CitationCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|title|locator|excerpt|timestamp|date|thumbnail|href|onClick|key|ref|className|style|children)$/]",
        "message": "<CitationCard> doesn't accept that prop. Declared props: type, title, locator, excerpt, timestamp, date, thumbnail, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='CitationCard'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:book|video)$/]",
        "message": "<CitationCard> type must be one of 'book' | 'video'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Composer'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|disabled|onSend|key|ref|className|style|children)$/]",
        "message": "<Composer> doesn't accept that prop. Declared props: placeholder, disabled, onSend."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisclosureBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:figureName|basis|compact|key|ref|className|style|children)$/]",
        "message": "<DisclosureBanner> doesn't accept that prop. Declared props: figureName, basis, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='FigureCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|era|description|categories|fields|available|selected|kind|portrait|onClick|key|ref|className|style|children)$/]",
        "message": "<FigureCard> doesn't accept that prop. Declared props: name, era, description, categories, fields, available, selected, kind, portrait, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='FigureCard'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:historical|creator)$/]",
        "message": "<FigureCard> kind must be one of 'historical' | 'creator'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MessageBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:role|author|register|children|citations|key|ref|className|style|children)$/]",
        "message": "<MessageBubble> doesn't accept that prop. Declared props: role, author, register, children, citations."
      },
      {
        "selector": "JSXOpeningElement[name.name='MessageBubble'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:assistant|user|system)$/]",
        "message": "<MessageBubble> role must be one of 'assistant' | 'user' | 'system'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MessageBubble'] > JSXAttribute[name.name='register'] > Literal[value!=/^(?:on-camera|conversational|written)$/]",
        "message": "<MessageBubble> register must be one of 'on-camera' | 'conversational' | 'written'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RegisterIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:registers|active|onNudge|key|ref|className|style|children)$/]",
        "message": "<RegisterIndicator> doesn't accept that prop. Declared props: registers, active, onNudge."
      },
      {
        "selector": "JSXOpeningElement[name.name='RegisterIndicator'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:on-camera|conversational|written)$/]",
        "message": "<RegisterIndicator> active must be one of 'on-camera' | 'conversational' | 'written'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionSidebar'] > JSXAttribute > JSXIdentifier[name!=/^(?:sessions|activeId|onSelect|onNew|key|ref|className|style|children)$/]",
        "message": "<SessionSidebar> doesn't accept that prop. Declared props: sessions, activeId, onSelect, onNew."
      },
      {
        "selector": "JSXOpeningElement[name.name='SourcesPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:figureName|basis|totals|books|videos|collections|onClose|key|ref|className|style|children)$/]",
        "message": "<SourcesPanel> doesn't accept that prop. Declared props: figureName, basis, totals, books, videos, collections, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='SuggestedQuestion'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|onClick|key|ref|className|style|children)$/]",
        "message": "<SuggestedQuestion> doesn't accept that prop. Declared props: text, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='TypingIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<TypingIndicator> doesn't accept that prop. Declared props: label."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
